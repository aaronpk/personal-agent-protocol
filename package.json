{
    "name": "personal-agent-protocol",
    "version": "0.1.0",
    "private": true,
    "packageManager": "pnpm@10.34.0",
    "engines": {
        "node": ">=20.9.0"
    },
    "scripts": {
        "dev": "next dev --hostname 0.0.0.0",
        "build": "next build",
        "typecheck": "tsc --noEmit",
        "format:check": "prettier --check .",
        "kit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/ts-hooks.mjs scripts/kit.ts",
        "test:kit": "node --test \"kit/company/validate/test/*.test.ts\""
    },
    "dependencies": {
        "@mdx-js/mdx": "3.1.1",
        "@vercel/analytics": "2.0.1",
        "lucide-react": "1.48.0",
        "next": "16.3.8",
        "react": "19.3.0",
        "react-dom": "19.3.0",
        "remark-gfm": "4.0.1",
        "remark-stringify": "11.0.0",
        "unified": "11.0.5"
    },
    "devDependencies": {
        "@types/hast": "3.0.5",
        "@types/mdast": "4.0.4",
        "@types/mdx": "2.0.14",
        "@types/node": "24.19.0",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "prettier": "3.6.2",
        "typescript": "5.9.3"
    }
}
